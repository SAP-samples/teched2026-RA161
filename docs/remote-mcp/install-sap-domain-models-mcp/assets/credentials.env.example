# SAP Domain Models MCP — client_credentials credentials (TEMPLATE)
#
# Copy this file to a private, per-environment path and fill it in, e.g.:
#   mkdir -p ~/.config/sap-domain-models
#   cp credentials.env.example ~/.config/sap-domain-models/mcp-prod-dewc-credentials.env
#   chmod 600 ~/.config/sap-domain-models/mcp-prod-dewc-credentials.env
#
# Do NOT commit the filled-in file. Helper commands read it from
# $SAP_DOMAIN_MODELS_MCP_CREDS_FILE.
#
# These belong to an SAP IAS application that has the `client_credentials` grant
# enabled and whose issued tokens carry the selected environment's service
# provider client ID in their `aud` claim. Credentials for prod DEWC and
# prod USEA are not interchangeable.
#
# For hand-written values, single quotes preserve backslashes literally and are
# recommended when the value contains no single quote. In double-quoted values,
# the helper decodes \\, \", \$, and \`. The binding wizard escapes these
# characters automatically.

SAP_DOMAIN_MODELS_IAS_TENANT="https://<your-ias-tenant-host>"
SAP_DOMAIN_MODELS_IAS_CLIENT_ID="<consumer-app-client-id>"
SAP_DOMAIN_MODELS_IAS_CLIENT_SECRET="<consumer-app-client-secret>"
